<Page x:Class="Arkhipova_523.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Arkhipova_523"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="Page1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Width="799"> 
            <TextBlock Text="Функция 1" HorizontalAlignment="Center" FontSize="30"/>
            <Image Source="Images/formula1.png" Width="500" Margin="0,0,0,25" HorizontalAlignment="Center"/>
        </StackPanel >

        <StackPanel Grid.RowSpan="1" Grid.Row="1">
            <Button Content="Вычислить" Width="136" Height="33" Margin="10" FontSize="16" HorizontalAlignment="Left"/>
            <Button Content="Очистить" Width="136" Height="28" Margin="10" FontSize="16" HorizontalAlignment="Left"/>
        </StackPanel>



    </Grid>
</Page>
