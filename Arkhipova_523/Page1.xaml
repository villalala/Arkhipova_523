<Page x:Class="Arkhipova_523.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Arkhipova_523"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background= "White"
      Title="Page1">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0">
            <TextBlock Text="Сумма" Margin="10" FontSize="22"/>
            <TextBox x:Name="txtSum" Margin="10" Width="200" Height="35" FontSize="16"/>

            <TextBlock Text="Срок(месяц)" Margin="10" FontSize="22"/>
            <TextBox x:Name="txtMonth" Margin="10" Width="200" Height="35" FontSize="16"/>

            <TextBlock Text="Процентная ставка" Margin="10" FontSize="22"/>
            <TextBox x:Name="txtProc" Margin="10" Width="200" Height="35" FontSize="16"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <StackPanel Margin="15">
                <TextBlock Text="Схема начисления %" FontSize="22"/>
                <RadioButton x:Name="rbSimple" Content="простые проценты" 
                             IsChecked="True" Margin="10" FontSize="22"/>
                <RadioButton x:Name="rbCompound" Content="сложные проценты" 
                             Margin="10" FontSize="22"/>
            </StackPanel>
        </StackPanel>
        
        <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="10">
            <TextBlock Text="Доход по вкладу =" FontSize="18" Margin="10"/>
            
            <TextBlock x:Name="txtResult" Text="0.00 ₽" FontSize="24" Margin="10"/>

            <Button Content="Вычислить" Height="45" FontSize="16" Click="BtnCalculate_Click"/>
        </StackPanel>
    </Grid>
</Page>
