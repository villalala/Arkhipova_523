<Page x:Class="Arkhipova_523.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Arkhipova_523"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="Page1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Исходный текст:" FontWeight="Bold" Grid.Row="0" Margin="10"/>
        <TextBox x:Name="txtInput" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True" Background="AliceBlue" Margin="10" 
             ToolTip="Введите текст. Поддерживаются только латинские буквы (A-Z, a-z). Остальные символы останутся без изменений." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="2" Margin="10">
            <Button x:Name="btnEncrypt" Content="Зашифровать" Width="140" Height="35" Margin="5" Click="BtnEncrypt_Click" 
                ToolTip="Применить шифрование ROT13" />
            <Button x:Name="btnDecrypt" Content="Дешифровать" Width="140" Height="35" Margin="5" Click="btnDecrypt_Click_2"
                ToolTip="Применить дешифрование ROT13" />
        </StackPanel>

        <TextBlock Text="Результат:" FontWeight="Bold" Grid.Row="3" Margin="10"/>
        <TextBox x:Name="txtOutput" Grid.Row="4" TextWrapping="Wrap" IsReadOnly="True" 
             Margin="10" Background="AliceBlue" />

        <TextBlock x:Name="txtError" Grid.Row="5" Foreground="Red" TextAlignment="Center"
               Margin="10" TextWrapping="Wrap" Visibility="Collapsed" />
    </Grid>
</Page>
