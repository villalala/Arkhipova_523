<Page x:Class="Arkhipova_523.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Arkhipova_523"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="Page2">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Width="799">
            <TextBlock Text="Функция 2" 
                       HorizontalAlignment="Center" 
                       FontSize="26"
                       ToolTip="Заголовок второй функции (кусочно-заданная функция с выбором f(x))"/>

            <Image Source="Images/formula2.png" 
                   Width="437" 
                   Height="132" 
                   HorizontalAlignment="Center"
                   ToolTip="Формула второй функции (вариант по вашему заданию)"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Width="180" HorizontalAlignment="Left">
                    <Button Content="Вычислить" 
                            Grid.Column="0" 
                            Width="136" 
                            Height="33" 
                            Margin="10" 
                            FontSize="16"
                            ToolTip="Нажмите, чтобы рассчитать значение функции по введённым x, i и выбранной f(x)" Click="BtnCalculate_Click"/>

                    <Button Content="Очистить" 
                            Grid.Column="0" 
                            Width="136" 
                            Height="31" 
                            Margin="10" 
                            FontSize="16"
                            ToolTip="Очистить поля ввода, выбор f(x) и результат" Click="BtnClear_Click"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Grid.Column="1">
                    <TextBlock Text="Результат:" 
                               FontSize="18"
                               ToolTip="Здесь отобразится вычисленное значение функции"/>

                    <TextBox x:Name="Result" 
                             Margin="15" 
                             HorizontalAlignment="Right" 
                             Width="421" 
                             Height="24" 
                             FontSize="18" 
                             IsReadOnly="True" 
                             Background="#F0F0F0"
                             ToolTip="Результат вычисления (поле защищено от редактирования)"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Right" Width="150">
                    <TextBlock Text="X" 
                               HorizontalAlignment="Right" 
                               Margin="10" 
                               FontSize="16"
                               ToolTip="Введите значение переменной x"/>

                    <TextBlock Text="I" 
                               HorizontalAlignment="Right" 
                               Margin="12" 
                               FontSize="16"
                               ToolTip="Введите целое число i (используется в условиях кусочной функции)"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBox x:Name="txtX" 
                             FontSize="16" 
                             Margin="10" 
                             Width="222"
                             ToolTip="Поле для ввода x (обязательно)"/>

                    <TextBox x:Name="txtM" 
                             FontSize="16" 
                             Margin="10" 
                             Width="222"
                             ToolTip="Поле для ввода i (целое число, обязательно)"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <RadioButton x:Name="rbSinh" 
                                 Content="sh(x) — гиперболический синус" 
                                 IsChecked="True" 
                                 GroupName="fGroup" 
                                 FontSize="20"
                                 ToolTip="Выбрать f(x) = sinh(x) (гиперболический синус)"/>

                    <RadioButton x:Name="rbX2" 
                                 Content="x²" 
                                 GroupName="fGroup" 
                                 FontSize="20"
                                 ToolTip="Выбрать f(x) = x² (квадрат)"/>

                    <RadioButton x:Name="rbExp" 
                                 Content="e^x" 
                                 GroupName="fGroup" 
                                 FontSize="20"
                                 ToolTip="Выбрать f(x) = e^x (экспонента)"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Назад" 
                    Width="136" 
                    Height="33" 
                    Margin="10" 
                    FontSize="16" 
                    HorizontalAlignment="Left"
                    ToolTip="Вернуться на предыдущую страницу (Функция 1)" Click="BtnBack_Click"/>

            <Button Content="Далее" 
                    Width="136" 
                    Height="33" 
                    Margin="10" 
                    FontSize="16" 
                    HorizontalAlignment="Right"
                    ToolTip="Перейти к следующей странице (табулирование и график)" Click="BtnNext_Click"/>
        </StackPanel>
    </Grid>
</Page>