<Page x:Class="Arkhipova_523.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Arkhipova_523"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="Page2">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Width="799">
            <TextBlock Text="Функция 2" HorizontalAlignment="Center" FontSize="26"/>
            <Image Source="Images/formula2.png" Width="437"  HorizontalAlignment="Center" Height="132"/>
        </StackPanel>

        <StackPanel Grid.Row="1" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Width="180" HorizontalAlignment="Left">
                    <Button Content="Вычислить" Grid.Column="0" Width="136" Height="33" Margin="10" FontSize="16" />
                    <Button Content="Очистить" Grid.Column="0" Width="136" Height="31" Margin="10" FontSize="16" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Grid.Column="2">
                    <TextBlock Text="Результат:" FontSize="18" ></TextBlock>
                    <TextBox x:Name="Result" Margin="15" HorizontalAlignment="Right" Width="421" Height="24" FontSize="18" IsReadOnly="True" Background="#F0F0F0" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel  Grid.Column="0" HorizontalAlignment="Right" Width="150">
                    <TextBlock Text="X" Grid.Column="0" HorizontalAlignment="Right" Margin="10" FontSize="16" ></TextBlock>
                    <TextBlock Text="I" Grid.Column="0" HorizontalAlignment="Right" Margin="12" FontSize="16" ></TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBox x:Name="txtX"  FontSize="16" Margin="10" Width="222"/>
                    <TextBox x:Name="txtM" FontSize="16" Margin="10" Width="222"/> 
                </StackPanel>

                <StackPanel Grid.Column="2" >
                    <RadioButton x:Name="rbSinh" Content="sh(x) — гиперболический синус" IsChecked="True" GroupName="fGroup" FontSize="20" ToolTip="f(x) = sinh(x)"/>
                    <RadioButton x:Name="rbX2" Content="x²" GroupName="fGroup" FontSize="20" ToolTip="f(x) = x * x"/>
                    <RadioButton x:Name="rbExp" Content="e^x" GroupName="fGroup" FontSize="20" ToolTip="f(x) = Math.Exp(x)"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Назад" Width="136" Height="33" Margin="10" FontSize="16" HorizontalAlignment="Left" />
            <Button Content="Далее" Width="136" Height="33" Margin="10" FontSize="16" HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</Page>
