<Page x:Class="Arkhipova_523.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Arkhipova_523"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="Page3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Width="799">
            <TextBlock Text="Функция 3" HorizontalAlignment="Center" FontSize="26"/>
            <Image Source="Images/formula3.png" Width="305"  HorizontalAlignment="Center" Height="71"/>
        </StackPanel>

        <StackPanel Grid.Row="1" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Width="180" HorizontalAlignment="Left">
                    <Button Content="Вычислить" Grid.Column="0" Width="129" Height="33" Margin="10" FontSize="16" />
                    <Button Content="Очистить" Grid.Column="0" Width="129" Height="31" Margin="10" FontSize="16" />
                </StackPanel>

            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel  Grid.Column="0" HorizontalAlignment="Right" Width="30">
                    <TextBlock Text="x₀" HorizontalAlignment="Right" Margin="5" FontSize="16" ></TextBlock>
                    <TextBlock Text="xₖ" HorizontalAlignment="Right" Margin="5" FontSize="16" ></TextBlock>
                    <TextBlock Text="dx" HorizontalAlignment="Right" Margin="6" FontSize="16" ></TextBlock>
                    <TextBlock Text="b" HorizontalAlignment="Right" Margin="7" FontSize="16" ></TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBox x:Name="X0" Margin="10,5" FontSize="16" ToolTip="Начало отрезка" Width="113"/>
                    <TextBox x:Name="Xk" Margin="10,5" FontSize="16" ToolTip="Конец отрезка"/>
                    <TextBox x:Name="Dx" Margin="10,5" FontSize="16" ToolTip="Шаг (положительный)"/>
                    <TextBox x:Name="B" Margin="10,5" FontSize="16" ToolTip="Параметр b"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Назад" Width="136" Height="33" Margin="10" FontSize="16" HorizontalAlignment="Left" />
            <Button Content="Далее" Width="136" Height="33" Margin="10" FontSize="16" HorizontalAlignment="Right" />
        </StackPanel>
        
    </Grid>
</Page>
